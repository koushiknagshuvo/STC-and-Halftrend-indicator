//@version=5
indicator("Liquidity Sweep + OB-FVG Entry Setup [4H]", overlay=true, max_boxes_count=500, max_labels_count=500)

// ============================= INPUTS =============================
grp1 = "Swing / Sweep Settings"
pivotLen   = input.int(5, "Swing Pivot Length (bars each side)", minval=1, group=grp1,
     tooltip="Apply this indicator on a 4H chart. All logic (sweep, displacement, FVG, OB) runs purely on the chart's own timeframe — no MTF requests.")
lookahead  = input.int(15, "Max Bars to Wait for Displacement/FVG after Sweep", minval=3, group=grp1,
     tooltip="FVG doesn't always form on the very next 1-3 candles after the sweep. Keep this generous (e.g. 10-15 bars) so slower displacements are still caught.")

grp2 = "FVG / Order Block Settings"
useATRFilter = input.bool(false, "Filter tiny FVGs using ATR", group=grp2)
atrLen       = input.int(14, "ATR Length", minval=1, group=grp2)
minFVGxATR   = input.float(0.15, "Min FVG size (x ATR)", minval=0.0, step=0.05, group=grp2)

grp3 = "Display"
showOB       = input.bool(true, "Show Order Block Box", group=grp3)
showFVG      = input.bool(true, "Show FVG Box", group=grp3)
showSweepTag = input.bool(true, "Show Sweep Markers", group=grp3)
extendBars   = input.int(25, "Box Extend to the Right (bars)", minval=1, group=grp3)

bullOBColor  = input.color(color.new(color.blue, 75), "Bullish OB Color", group=grp3)
bearOBColor  = input.color(color.new(color.red, 75), "Bearish OB Color", group=grp3)
bullFVGColor = input.color(color.new(color.teal, 82), "Bullish FVG Color", group=grp3)
bearFVGColor = input.color(color.new(color.orange, 82), "Bearish FVG Color", group=grp3)

// ============================= SWING / PIVOT TRACKING =============================
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

var float lastPH = na
var float lastPL = na
var bool  phSwept = true
var bool  plSwept = true

if not na(ph)
    lastPH := ph
    phSwept := false
if not na(pl)
    lastPL := pl
    plSwept := false

// ============================= LIQUIDITY SWEEP DETECTION (4H candle wick+close) =============================
bearSweep = not phSwept and not na(lastPH) and high > lastPH and close < lastPH   // swept a swing high -> bearish bias
bullSweep = not plSwept and not na(lastPL) and low < lastPL and close > lastPL   // swept a swing low  -> bullish bias

if bearSweep
    phSwept := true
if bullSweep
    plSwept := true

// ============================= WAIT-FOR-DISPLACEMENT STATE =============================
var bool waitingBearDisp = false
var int  bearSweepBar    = na
var bool waitingBullDisp = false
var int  bullSweepBar    = na

if bearSweep
    waitingBearDisp := true
    bearSweepBar := bar_index
if bullSweep
    waitingBullDisp := true
    bullSweepBar := bar_index

if waitingBearDisp and (bar_index - bearSweepBar > lookahead)
    waitingBearDisp := false
if waitingBullDisp and (bar_index - bullSweepBar > lookahead)
    waitingBullDisp := false

// ============================= FVG (3-CANDLE FAIR VALUE GAP) =============================
atrVal = ta.atr(atrLen)

bullFVGraw  = low > high[2]
bearFVGraw  = high < low[2]
bullFVGsize = low - high[2]
bearFVGsize = low[2] - high

bullFVG = bullFVGraw and (not useATRFilter or bullFVGsize >= minFVGxATR * atrVal)
bearFVG = bearFVGraw and (not useATRFilter or bearFVGsize >= minFVGxATR * atrVal)

// ============================= ENTRY-ZONE (OB + FVG) FORMATION =============================
// Order Block = the candle immediately preceding the FVG pattern (bar offset 2 from the bar where FVG confirms)
bullEntryZone = false
bearEntryZone = false

if waitingBullDisp and bullFVG
    obHigh = high[2]
    obLow  = low[2]
    obLeft = bar_index - 2
    if showOB
        box.new(obLeft, obHigh, bar_index + extendBars, obLow, border_color=color.blue, bgcolor=bullOBColor, extend=extend.none)
    if showFVG
        box.new(bar_index - 2, high[2], bar_index + extendBars, low, border_color=color.teal, bgcolor=bullFVGColor, extend=extend.none)
    bullEntryZone := true
    waitingBullDisp := false

if waitingBearDisp and bearFVG
    obHigh2 = high[2]
    obLow2  = low[2]
    obLeft2 = bar_index - 2
    if showOB
        box.new(obLeft2, obHigh2, bar_index + extendBars, obLow2, border_color=color.red, bgcolor=bearOBColor, extend=extend.none)
    if showFVG
        box.new(bar_index - 2, low[2], bar_index + extendBars, high, border_color=color.orange, bgcolor=bearFVGColor, extend=extend.none)
    bearEntryZone := true
    waitingBearDisp := false

// ============================= VISUAL SWEEP MARKERS =============================
if showSweepTag and bearSweep
    label.new(bar_index, high, "SWEEP", style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.tiny)
if showSweepTag and bullSweep
    label.new(bar_index, low, "SWEEP", style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.tiny)

plotshape(bearSweep, title="Bearish Liquidity Sweep", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)
plotshape(bullSweep, title="Bullish Liquidity Sweep", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.tiny)

// ============================= ALERTS =============================
alertcondition(bearSweep, title="Bearish Liquidity Sweep", message="{{ticker}} {{interval}}: Bearish liquidity sweep detected (swing high swept). Watch for bearish displacement + FVG.")
alertcondition(bullSweep, title="Bullish Liquidity Sweep", message="{{ticker}} {{interval}}: Bullish liquidity sweep detected (swing low swept). Watch for bullish displacement + FVG.")
alertcondition(bearEntryZone, title="Bearish OB+FVG Entry Zone Formed", message="{{ticker}} {{interval}}: Bearish Order Block + FVG entry zone formed after sweep. Potential SELL setup.")
alertcondition(bullEntryZone, title="Bullish OB+FVG Entry Zone Formed", message="{{ticker}} {{interval}}: Bullish Order Block + FVG entry zone formed after sweep. Potential BUY setup.")
